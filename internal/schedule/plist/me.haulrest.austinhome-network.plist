<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>me.haulrest.austinhome-network</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>/usr/sbin/sysctl -w net.inet.ip.forwarding=1 &amp;&amp; /sbin/pfctl -ef /etc/pf.conf</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/tmp/austinhome-network.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/austinhome-network.log</string>
</dict>
</plist>
