<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>me.haulrest.austinhome-reboot</string>

	<key>ProgramArguments</key>
	<array>
		<string>/sbin/shutdown</string>
		<string>-r</string>
		<string>now</string>
	</array>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Day</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>StandardOutPath</key>
	<string>/tmp/austinhome-reboot.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/austinhome-reboot.log</string>
</dict>
</plist>
